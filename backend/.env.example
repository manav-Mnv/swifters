# Required. Admin login is disabled until this is set.
ADMIN_PASSWORD=choose-a-long-random-password

# Required in production. Signs the admin session cookie; keep it secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# The frontend origin allowed to call the API (e.g. https://swifters.vercel.app)
ALLOWED_ORIGIN=https://swifters.vercel.app
BACKEND_URL=http://127.0.0.1:5000

# Set to 1 only on your own machine. Never in production.
FLASK_DEBUG=0
